{
  "name": "delivery-api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#lib/*": "./src/lib/*.js"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:init": "node scripts/init-db.mjs",
    "db:check": "node scripts/db-check.mjs",
    "docs:openapi": "node scripts/gen-openapi.mjs",
    "api:smoke": "node scripts/api-smoke.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "express": "5.3.0",
    "swagger-ui-dist": "5.35.0"
  }
}
